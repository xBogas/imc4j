#SOI Executive settings

#Nominal Speed
speed=1.0

#Maximum Depth
maxDepth=4.0

#Minimum Depth
minDepth=0.0

#Maximum Speed
maxSpeed=1.5

#Minimum Speed
minSpeed=0.7

#DUNE Host Address
hAddr=127.0.0.1

#DUNE Host Port (TCP)
hPort=6006

#Minutes before termination
timeout=30

#Maximum time without reporting position
minsOff=15

#Maximum time without GPS
minsUnder=3

#Seconds to idle at each vertex
wptSecs=10

#Maximum seconds to wait at each vertex
wptMaxWait=15

#Distance to consider waypoint was reached
wptDst=50.0

#Cyclic execution
cycle=false

#Speed up before descending
descRpm=1300

#Upload temperature profiles
upTemp=false

#Upload salinity profiles
upSal=true

#Align with destination waypoint before going underwater
align=true

#Split transects based on maximum offline time
split=false

#Use vertical profile as the data profiler
useVP=false

#Sample to send for meters covered
space_resolution=120.0

#Depth tolerance to consider as reached
depthTolerance=0.3

